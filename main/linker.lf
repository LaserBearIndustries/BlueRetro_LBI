# Which objects run from IRAM rather than flash.
#
# The bus drivers are conditional, and that is worth explaining. Every
# console BlueRetro supports has its own driver, and a build with the system
# fixed at compile time can only ever reach one of them: main() assigns
# wired_adapter.system_id = HARDCODED_SYS, and detect_init() is compiled only
# for a universal build. The rest are dead code.
#
# Dead code in IRAM is expensive here. Mapping all of them unconditionally
# left 326 bytes of 131072 free, and moving the unreachable ones to flash on
# a GameCube build recovers 21096 - about 16% of the whole region, at no
# runtime cost, because the code never executes.
#
# A universal build still needs them all: it does not know what it is plugged
# into until it looks.
#
# The mapping of driver to console comes from wired_init[] in
# wired/wired_bare.c. Keep the two in step - a driver reachable at runtime
# but left in flash is a bus whose bit timing quietly stops working.

[mapping:main]
archive: libmain.a
entries:
    # Needed whatever the console is.
    main (noflash)
    atomic (noflash)
    core0_stall (noflash)
    core0_stall_highint_hdl (noflash)
    gpio (noflash)
    intr (noflash)
    led (noflash)
    delay (noflash)
    wired_bare (noflash)
    devcrypto (noflash)

    # Only a universal build probes for the console it is attached to.
    if BLUERETRO_SYSTEM_UNIVERSAL = y:
        detect (noflash)

    # One bus driver per console.
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_NES = y || BLUERETRO_SYSTEM_VBOY = y:
        npiso_io (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_PCE = y:
        pce_io (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_GENESIS = y || BLUERETRO_SYSTEM_SATURN = y:
        sega_io (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_SNES = y:
        snes_spi (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_CDI = y:
        cdi_uart (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_3DO = y:
        real_spi (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_JAGUAR = y:
        jag_io (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_PSX_PS2 = y:
        ps_spi (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_PCFX = y:
        pcfx_spi (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_JVS = y:
        jvs_uart (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_N64 = y || BLUERETRO_SYSTEM_GC = y:
        nsi (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_DC = y:
        maple (noflash)
    if BLUERETRO_SYSTEM_UNIVERSAL = y || BLUERETRO_SYSTEM_WII_EXT = y:
        wii_i2c (noflash)

[sections:gcov_info]
entries:
    .gcov_info

[scheme:gcov_default]
entries:
    gcov_info -> flash_rodata

[mapping:gcov_info]
archive: *
entries:
    * (gcov_default);
    gcov_info -> flash_rodata KEEP() SURROUND(_gcov_info)
