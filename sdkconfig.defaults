CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CTRL_BLE_ENABLE=y
CONFIG_BT_CTRL_BREDR_ENABLE=y
CONFIG_BT_CTRL_BR_EDR_MAX_ACL_CONN=7
CONFIG_BT_LE_MAX_CONNECTIONS=7
CONFIG_BT_CTRL_SLEEP_ENABLE=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
CONFIG_ETH_USE_ESP32_EMAC=n
CONFIG_ETH_USE_SPI_ETHERNET=n
CONFIG_ESP_EVENT_POST_FROM_ISR=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
# The S31 board has 16 MB of PSRAM, but nothing uses it yet and the wired driver
# on the bare-metal core cannot reach it while that core runs with its data cache
# off. Turning SPIRAM on changes heap and startup behaviour, so leave it until
# the port boots and the memory-card question in PORTING-S31.md is settled.
# CONFIG_SPIRAM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_UNICORE=y
CONFIG_HAL_ASSERTION_DISABLE=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_LIBC_STDOUT_LINE_ENDING_LF=y
CONFIG_LIBC_STDIN_LINE_ENDING_LF=y
CONFIG_SPIFFS_MAX_PARTITIONS=1
